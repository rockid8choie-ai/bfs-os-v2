# Postgres — Neon 풀러(앱) / 다이렉트(마이그레이션)
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT — 배포 환경에서는 반드시 다른 긴 비밀값
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 같은 오리진이면 비워 둔다. 프론트와 API를 분리할 때만 채운다.
NEXT_PUBLIC_API_BASE_URL=""

# 소셜 로그인 — 키가 있는 제공자만 로그인 화면에 버튼이 노출된다.
# 콘솔 리다이렉트 URI: {origin}/api/auth/oauth/{provider}/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
